# Postgres connection string.
# Leave unset to run the site in static mode from the bundled dataset.
# Set it to enable the guestbook, resource submissions and resonance counts.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Optional. Enables live Claude answers in the "Ask miii.ai" assistant.
# Without it the built-in grounded knowledge base answers.
ANTHROPIC_API_KEY=""
